        {
          "id": "ea0318ff-fa55-466a-8d1d-c88af51cda1a",
          "name": "Get all quota for a device",
          "request": {
            "name": "Get all quota for a device",
            "description": {
              "content": "Returns a full snapshot of every property (\"quota\") value the specified device currently reports (battery %, input/output watts, switch states, temperatures, etc.). The `data` object is a flat map of dotted quota keys to values and varies by product line.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "iot-open",
                "sign",
                "device",
                "quota",
                "all"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sn",
                  "value": "<string>",
                  "description": "(Required) Device serial number"
                }
              ],
              "variable": []
            },
            "header": [
